# Use a lightweight Python base image
FROM python:3.11-slim

# Prevent Python from writing .pyc files to disk and ensure output is printed directly to terminal
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set the working directory inside the container
WORKDIR /app

# Install system dependencies (build tools, PostgreSQL libs, and Pillow image dependencies)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file first to take advantage of Docker's layer caching
COPY backend/requirements.txt /app/requirements.txt

# Install python packages
RUN pip install --no-cache-dir -r requirements.txt

# Install gunicorn for production serving
RUN pip install --no-cache-dir gunicorn

# Copy backend codebase into the container
COPY manage.py /app/
COPY backend/ /app/backend/
COPY ai/ /app/ai/
COPY reports/ /app/reports/

# Expose Django server port
EXPOSE 8000

# Start server using Gunicorn
CMD ["gunicorn", "backend.wsgi:application", "--bind", "0.0.0.0:8000"]
